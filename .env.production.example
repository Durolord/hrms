# Demo deployment: hrms.durolord.com (cPanel). Copy to .env on the server and fill in.
APP_NAME="Duro HRMS Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hrms.durolord.com
APP_TIMEZONE=Africa/Lagos
DEMO_MODE=true

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Demo sends no real mail. Use a cPanel mailbox only if you enable password reset for real users.
MAIL_MAILER=log
